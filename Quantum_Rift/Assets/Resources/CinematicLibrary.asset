    - {fileID: 21300000, guid: 7a0097497ea2d184590d6d9cc8fcb558, type: 3}
    - {fileID: 21300000, guid: c6e03e705dd1b97468f3bb7dec1fbada, type: 3}
    - {fileID: 21300000, guid: fa613fa2705c4f64388267d6f1aa7851, type: 3}
    accent: {r: 0.46666667, g: 0.92156863, b: 0.76862746, a: 1}
  - titleThai: "\u0E15\u0E49\u0E19\u0E15\u0E2D\u0E41\u0E2B\u0E48\u0E07\u0E01\u0E32\u0E23\u0E25\u0E48\u0E21\u0E2A\u0E25\u0E32\u0E22"
    titleEnglish: THE SOURCE OF COLLAPSE
    bodyThai: "\u0E1B\u0E25\u0E32\u0E22\u0E17\u0E32\u0E07\u0E04\u0E37\u0E2D\u0E23\u0E31\u0E07\u0E21\u0E34\u0E15\u0E34
      \u0E17\u0E35\u0E48\u0E0B\u0E36\u0E48\u0E07 The Architect of Collapse \u0E23\u0E2D\u0E2D\u0E22\u0E39\u0E48\n\u0E1D\u0E48\u0E32\u0E1A\u0E2D\u0E2A\u0E17\u0E35\u0E48\u0E02\u0E27\u0E32\u0E07\u0E17\u0E32\u0E07
      \u0E44\u0E1B\u0E16\u0E36\u0E07\u0E43\u0E08\u0E01\u0E25\u0E32\u0E07\u0E23\u0E31\u0E07
      \u0E41\u0E25\u0E30\u0E2B\u0E22\u0E38\u0E14\u0E20\u0E31\u0E22\u0E08\u0E32\u0E01\u0E23\u0E2D\u0E22\u0E41\u0E22\u0E01\u0E01\u0E48\u0E2D\u0E19\u0E17\u0E38\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E08\u0E30\u0E25\u0E48\u0E21\u0E2A\u0E25\u0E32\u0E22"
    bodyEnglish: 'The path ends in the dimensional hive, where The Architect of Collapse
      awaits.

      Overcome the bosses in your way, reach the heart of the hive,
      and stop the rift before everything collapses.'
    backgrounds:
    - {fileID: 21300000, guid: de9a4942221506445acfe3b7bb149d99, type: 3}
