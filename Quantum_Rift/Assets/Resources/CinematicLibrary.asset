  m_Script: {fileID: 11500000, guid: 9205a8a7fef865f41b4d24f7c1881183, type: 3}
  m_Name: CinematicLibrary
  m_EditorClassIdentifier: Assembly-CSharp::CinematicLibrary
  opening:
  - titleThai: "\u0E2A\u0E31\u0E0D\u0E0D\u0E32\u0E13\u0E08\u0E32\u0E01\u0E0B\u0E32\u0E01\u0E22\u0E32\u0E19"
    titleEnglish: A SIGNAL IN THE WRECKAGE
    bodyThai: "\u0E23\u0E2D\u0E22\u0E41\u0E22\u0E01\u0E04\u0E27\u0E2D\u0E19\u0E15\u0E31\u0E21\u0E09\u0E35\u0E01\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E21\u0E34\u0E15\u0E34
      \u0E0B\u0E32\u0E01\u0E22\u0E32\u0E19\u0E2D\u0E27\u0E01\u0E32\u0E28\u0E04\u0E37\u0E2D\u0E08\u0E38\u0E14\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E02\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E40\u0E14\u0E34\u0E19\u0E17\u0E32\u0E07\n\u0E04\u0E38\u0E13\u0E15\u0E49\u0E2D\u0E07\u0E1D\u0E48\u0E32\u0E28\u0E31\u0E15\u0E23\u0E39\u0E17\u0E35\u0E48\u0E40\u0E1D\u0E49\u0E32\u0E2D\u0E22\u0E39\u0E48
      \u0E41\u0E25\u0E30\u0E04\u0E49\u0E19\u0E2B\u0E32\u0E17\u0E32\u0E07\u0E44\u0E1B\u0E22\u0E31\u0E07\u0E15\u0E49\u0E19\u0E15\u0E2D\u0E02\u0E2D\u0E07\u0E23\u0E2D\u0E22\u0E41\u0E22\u0E01"
    bodyEnglish: 'A quantum rift has torn a path between dimensions. Your journey
      begins in the wreckage of a spaceship.

      Fight past its defenders and
      find the way to the source of the rift.'
    backgrounds:
    - {fileID: 21300000, guid: 3799c875d3bfd234cb026b1fa6f559aa, type: 3}
    - {fileID: 21300000, guid: 1d472ee41744f424f835613e76c1d079, type: 3}
    - {fileID: 21300000, guid: 27f6db5be915fc541a310c608d228bc8, type: 3}
    - {fileID: 21300000, guid: 38d3712a415d764498c23dfb831b84c7, type: 3}
    - {fileID: 21300000, guid: a9f69dc4fb0e24a44bb9caa4f3282c18, type: 3}
    - {fileID: 21300000, guid: d587e0d7478bc994ebbbe09db5a581b0, type: 3}
    - {fileID: 21300000, guid: db2f1a4ed88a44d4f8c8250a23845a22, type: 3}
    accent: {r: 0.4117647, g: 0.85490197, b: 0.95686275, a: 1}
  - titleThai: "\u0E2D\u0E35\u0E01\u0E1F\u0E32\u0E01\u0E02\u0E2D\u0E07\u0E23\u0E2D\u0E22\u0E41\u0E22\u0E01"
    titleEnglish: BEYOND THE RIFT
    bodyThai: "\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E1E\u0E32\u0E04\u0E38\u0E13\u0E2A\u0E39\u0E48\u0E21\u0E34\u0E15\u0E34\u0E1B\u0E48\u0E32\u0E17\u0E35\u0E48\u0E40\u0E15\u0E34\u0E1A\u0E42\u0E15\u0E41\u0E25\u0E30\u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E2B\u0E27\u0E44\u0E14\u0E49
      \u0E1E\u0E37\u0E0A\u0E1E\u0E34\u0E29\u0E01\u0E31\u0E1A\u0E2A\u0E34\u0E48\u0E07\u0E21\u0E35\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E15\u0E48\u0E32\u0E07\u0E21\u0E34\u0E15\u0E34\u0E02\u0E27\u0E32\u0E07\u0E17\u0E32\u0E07\u0E2D\u0E22\u0E39\u0E48\n\u0E40\u0E01\u0E47\u0E1A\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E41\u0E25\u0E30\u0E1E\u0E25\u0E31\u0E07\u0E17\u0E35\u0E48\u0E1E\u0E1A\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E17\u0E32\u0E07
      \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E40\u0E1C\u0E0A\u0E34\u0E0D\u0E1C\u0E39\u0E49\u0E1E\u0E34\u0E17\u0E31\u0E01\u0E29\u0E4C\u0E02\u0E2D\u0E07\u0E1B\u0E48\u0E32"
    bodyEnglish: 'Beyond the wreckage lies a living forest dimension. Poisonous plants
      and creatures stand in your way.

      Gather weapons and powers along the
      journey before facing the forest''s guardian.'
    backgrounds:
    - {fileID: 21300000, guid: 63c14c4d36d645f4495066cf9fb49d44, type: 3}
    - {fileID: 21300000, guid: 4832c6be068cd424e87ef87dfc241d12, type: 3}
    - {fileID: 21300000, guid: b288a41bfb2ec364c8fd4dd3c66e7336, type: 3}
