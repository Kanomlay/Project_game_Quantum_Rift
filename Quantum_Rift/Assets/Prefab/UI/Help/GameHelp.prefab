      thai: "\u0E2D\u0E48\u0E32\u0E19\u0E44\u0E14\u0E49\u0E17\u0E38\u0E01\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E14\u0E49\u0E27\u0E22\u0E1B\u0E38\u0E48\u0E21
        ? \u0E2B\u0E23\u0E37\u0E2D F1"
      english: Open this guide anytime with ? or F1
    sections:
    - heading:
        thai: "01  \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E2E\u0E35\u0E42\u0E23\u0E48"
        english: 01  Choose your hero
      body:
        thai: "\u0E14\u0E39\u0E40\u0E25\u0E37\u0E2D\u0E14 \u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19
          \u0E41\u0E25\u0E30\u0E2A\u0E01\u0E34\u0E25 Q / E \u0E1A\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E15\u0E31\u0E27\u0E25\u0E30\u0E04\u0E23\n\u0E41\u0E15\u0E48\u0E25\u0E30\u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E21\u0E35\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E41\u0E25\u0E30\u0E2A\u0E44\u0E15\u0E25\u0E4C\u0E01\u0E32\u0E23\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E15\u0E48\u0E32\u0E07\u0E01\u0E31\u0E19"
        english: 'Review HP, energy and Q / E skills on the hero screen.

          Each
          class has its own starting weapon and combat style.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "02  \u0E2A\u0E33\u0E23\u0E27\u0E08\u0E41\u0E25\u0E30\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E15\u0E31\u0E27"
        english: 02  Explore and prepare
      body:
        thai: "\u0E40\u0E02\u0E49\u0E32\u0E2B\u0E49\u0E2D\u0E07 \u0E01\u0E33\u0E08\u0E31\u0E14\u0E28\u0E31\u0E15\u0E23\u0E39
          \u0E40\u0E01\u0E47\u0E1A\u0E40\u0E07\u0E34\u0E19\u0E41\u0E25\u0E30\u0E44\u0E2D\u0E40\u0E17\u0E47\u0E21\n\u0E41\u0E27\u0E30\u0E23\u0E49\u0E32\u0E19\u0E04\u0E49\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E0B\u0E37\u0E49\u0E2D\u0E2D\u0E32\u0E27\u0E38\u0E18
          \u0E22\u0E32 \u0E2B\u0E23\u0E37\u0E2D\u0E1A\u0E31\u0E1E\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E08\u0E2D\u0E1A\u0E2D\u0E2A"
        english: 'Enter rooms, defeat enemies and collect coins and items.

          Visit
          shops for weapons, potions or buffs before a boss.'
      accent: {r: 1, g: 0.81960785, b: 0.43529412, a: 1}
    - heading:
        thai: "03  \u0E40\u0E2D\u0E32\u0E15\u0E31\u0E27\u0E23\u0E2D\u0E14\u0E43\u0E2B\u0E49\u0E16\u0E36\u0E07\u0E1A\u0E2D\u0E2A"
        english: 03  Survive the encounter
      body:
        thai: "\u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E2B\u0E25\u0E1A\u0E01\u0E32\u0E23\u0E42\u0E08\u0E21\u0E15\u0E35
          \u0E41\u0E25\u0E30\u0E2A\u0E31\u0E07\u0E40\u0E01\u0E15\u0E2A\u0E31\u0E0D\u0E0D\u0E32\u0E13\u0E40\u0E15\u0E37\u0E2D\u0E19\u0E1A\u0E19\u0E1E\u0E37\u0E49\u0E19\n\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2B\u0E21\u0E14\u0E04\u0E37\u0E2D\u0E08\u0E1A\u0E23\u0E2D\u0E1A
          \u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E01\u0E21\u0E43\u0E2B\u0E21\u0E48\u0E08\u0E30\u0E23\u0E35\u0E40\u0E0B\u0E47\u0E15\u0E1E\u0E23\u0E41\u0E25\u0E30\u0E1A\u0E31\u0E1E\u0E02\u0E2D\u0E07\u0E23\u0E2D\u0E1A\u0E19\u0E31\u0E49\u0E19"
        english: 'Keep moving and watch for warning areas on the floor.

          At
          zero HP the run ends. A new run resets blessings and buffs.'
      accent: {r: 1, g: 0.5803922, b: 0.61960787, a: 1}
  - tab:
      thai: "\u0E1B\u0E38\u0E48\u0E21\u0E04\u0E27\u0E1A\u0E04\u0E38\u0E21"
      english: Controls
    title:
      thai: "\u0E04\u0E27\u0E1A\u0E04\u0E38\u0E21\u0E2E\u0E35\u0E42\u0E23\u0E48\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13"
      english: Control your hero
    summary:
      thai: "\u0E04\u0E35\u0E22\u0E4C\u0E1A\u0E2D\u0E23\u0E4C\u0E14\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48
        \xB7 \u0E40\u0E21\u0E32\u0E2A\u0E4C\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E40\u0E25\u0E47\u0E07"
      english: "Move with the keyboard \xB7 Aim with the mouse"
    sections:
    - heading:
        thai: "W A S D / \u0E25\u0E39\u0E01\u0E28\u0E23  \xB7  \u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48"
        english: "W A S D / Arrow keys  \xB7  Move"
      body:
        thai: "\u0E01\u0E14\u0E1B\u0E38\u0E48\u0E21\u0E17\u0E34\u0E28\u0E17\u0E32\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E14\u0E34\u0E19 
          \xB7  \u0E01\u0E14 Shift \u0E04\u0E49\u0E32\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E27\u0E34\u0E48\u0E07\n\u0E40\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E40\u0E21\u0E32\u0E2A\u0E4C\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E2B\u0E31\u0E19\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E44\u0E1B\u0E22\u0E31\u0E07\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22"
        english: 'Use direction keys to move. Hold Shift to run.

          Move
          the mouse to aim your weapon.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "\u0E04\u0E25\u0E34\u0E01\u0E0B\u0E49\u0E32\u0E22  \xB7  \u0E42\u0E08\u0E21\u0E15\u0E35    
          Q / E  \xB7  \u0E2A\u0E01\u0E34\u0E25"
        english: "Left mouse  \xB7  Attack     Q / E  \xB7  Skills"
      body:
        thai: "\u0E18\u0E19\u0E39: \u0E01\u0E14\u0E04\u0E49\u0E32\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E07\u0E49\u0E32\u0E07
          \u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E22\u0E34\u0E07\n\u0E14\u0E39\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E17\u0E35\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E0A\u0E49\u0E41\u0E25\u0E30\u0E04\u0E39\u0E25\u0E14\u0E32\u0E27\u0E19\u0E4C\u0E01\u0E48\u0E2D\u0E19\u0E01\u0E14\u0E2A\u0E01\u0E34\u0E25\u0E0B\u0E49\u0E33"
        english: 'Bow: hold to draw, then release to fire.

          Check your
          energy and skill cooldowns before using them again.'
      accent: {r: 1, g: 0.81960785, b: 0.43529412, a: 1}
    - heading:
        thai: "F  \xB7  \u0E43\u0E0A\u0E49\u0E07\u0E32\u0E19     R  \xB7  \u0E2A\u0E25\u0E31\u0E1A\u0E2D\u0E32\u0E27\u0E38\u0E18"
        english: "F  \xB7  Interact     R  \xB7  Swap weapon"
      body:
        thai: "F \u0E43\u0E0A\u0E49\u0E40\u0E01\u0E47\u0E1A\u0E2D\u0E32\u0E27\u0E38\u0E18
          \u0E40\u0E1B\u0E34\u0E14\u0E23\u0E49\u0E32\u0E19 \u0E2B\u0E23\u0E37\u0E2D\u0E43\u0E0A\u0E49\u0E27\u0E32\u0E23\u0E4C\u0E1B\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E01\u0E25\u0E49\nR
          \u0E2A\u0E25\u0E31\u0E1A\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E2A\u0E2D\u0E07\u0E0A\u0E48\u0E2D\u0E07 
          \xB7  Esc \u0E2B\u0E22\u0E38\u0E14\u0E40\u0E01\u0E21  \xB7  F1 \u0E40\u0E1B\u0E34\u0E14/\u0E1B\u0E34\u0E14\u0E04\u0E39\u0E48\u0E21\u0E37\u0E2D"
        english: 'Use F near a weapon, shop or portal. R swaps weapon slots.

          Esc
          pauses the game. F1 opens or closes this guide.'
      accent: {r: 0.5882353, g: 0.8862745, b: 0.7019608, a: 1}
  - tab:
      thai: "\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E41\u0E25\u0E30\u0E23\u0E30\u0E14\u0E31\u0E1A"
      english: Weapons & rarity
    title:
      thai: "\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E41\u0E25\u0E30\u0E2A\u0E35\u0E23\u0E30\u0E14\u0E31\u0E1A"
      english: Weapons and rarity
    summary:
      thai: "\u0E2A\u0E35\u0E0A\u0E48\u0E27\u0E22\u0E1A\u0E2D\u0E01\u0E23\u0E30\u0E14\u0E31\u0E1A
        \u0E41\u0E15\u0E48\u0E04\u0E27\u0E23\u0E2D\u0E48\u0E32\u0E19\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E02\u0E2D\u0E07\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E14\u0E49\u0E27\u0E22"
      english: Color shows rarity; special abilities matter too
    sections:
    - heading:
        thai: "\u0E2A\u0E35\u0E02\u0E32\u0E27  \xB7  \u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19
          / \u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B"
        english: "White  \xB7  Starter / Common"
      body:
        thai: "\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E15\u0E34\u0E14\u0E21\u0E32\u0E01\u0E31\u0E1A\u0E2E\u0E35\u0E42\u0E23\u0E48
          \u0E2D\u0E32\u0E27\u0E38\u0E18\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B\u0E1E\u0E1A\u0E44\u0E14\u0E49\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E40\u0E25\u0E48\u0E19\n\u0E16\u0E37\u0E2D\u0E44\u0E14\u0E49\u0E2A\u0E2D\u0E07\u0E0A\u0E34\u0E49\u0E19
          \u0E2B\u0E32\u0E01\u0E40\u0E15\u0E47\u0E21 \u0E01\u0E32\u0E23\u0E40\u0E01\u0E47\u0E1A\u0E0A\u0E34\u0E49\u0E19\u0E43\u0E2B\u0E21\u0E48\u0E08\u0E30\u0E41\u0E17\u0E19\u0E0A\u0E34\u0E49\u0E19\u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E16\u0E37\u0E2D"
        english: 'Heroes begin with a starting weapon. Common weapons appear in runs.

          Carry
          two weapons; a new pickup replaces the active one if both slots are full.'
      accent: {r: 0.92156863, g: 0.9098039, b: 0.95686275, a: 1}
    - heading:
        thai: "\u0E2A\u0E35\u0E1F\u0E49\u0E32  \xB7  \u0E2B\u0E32\u0E22\u0E32\u0E01"
        english: "Blue  \xB7  Rare"
      body:
        thai: "\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E2B\u0E32\u0E22\u0E32\u0E01\u0E21\u0E35\u0E25\u0E31\u0E01\u0E29\u0E13\u0E30\u0E2B\u0E23\u0E37\u0E2D\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E15\u0E48\u0E32\u0E07\u0E08\u0E32\u0E01\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E17\u0E31\u0E48\u0E27\u0E44\u0E1B\n\u0E14\u0E39\u0E04\u0E48\u0E32\u0E14\u0E32\u0E40\u0E21\u0E08
          \u0E04\u0E27\u0E32\u0E21\u0E40\u0E23\u0E47\u0E27\u0E42\u0E08\u0E21\u0E15\u0E35
          \u0E41\u0E25\u0E30\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E1B\u0E23\u0E30\u0E01\u0E2D\u0E1A\u0E01\u0E32\u0E23\u0E40\u0E25\u0E37\u0E2D\u0E01"
        english: 'Rare weapons offer different stats or abilities.

          Compare
          damage, attack speed and energy cost when choosing.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "\u0E2A\u0E35\u0E17\u0E2D\u0E07  \xB7  \u0E15\u0E33\u0E19\u0E32\u0E19"
        english: "Gold  \xB7  Legendary"
      body:
        thai: "\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E15\u0E33\u0E19\u0E32\u0E19\u0E21\u0E35\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E1E\u0E34\u0E40\u0E28\u0E29\u0E15\u0E32\u0E21\u0E0A\u0E19\u0E34\u0E14\n\u0E15\u0E31\u0E27\u0E2D\u0E22\u0E48\u0E32\u0E07:
          \u0E04\u0E49\u0E2D\u0E19\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E17\u0E2D\u0E07\u0E01\u0E14\u0E04\u0E49\u0E32\u0E07\u0E0A\u0E32\u0E23\u0E4C\u0E08
          \u0E41\u0E25\u0E49\u0E27\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E17\u0E38\u0E1A\u0E27\u0E07\u0E01\u0E27\u0E49\u0E32\u0E07"
        english: 'Legendary weapons have special abilities.

          For example,
          hold then release a gold hammer for a wide charged slam.'
      accent: {r: 1, g: 0.81960785, b: 0.43529412, a: 1}
  - tab:
      thai: "\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E41\u0E25\u0E30\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19"
      english: HP & energy
    title:
      thai: "\u0E14\u0E39\u0E41\u0E25\u0E17\u0E23\u0E31\u0E1E\u0E22\u0E32\u0E01\u0E23\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13"
      english: Manage your resources
    summary:
      thai: "\u0E2B\u0E25\u0E2D\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E41\u0E25\u0E30\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E2D\u0E22\u0E39\u0E48\u0E21\u0E38\u0E21\u0E0B\u0E49\u0E32\u0E22\u0E1A\u0E19"
      english: HP and energy bars are at the top left
    sections:
    - heading:
        thai: "\u0E40\u0E25\u0E37\u0E2D\u0E14  \xB7  \u0E41\u0E16\u0E1A\u0E2A\u0E35\u0E41\u0E14\u0E07"
        english: "HP  \xB7  Red bar"
      body:
        thai: "\u0E28\u0E31\u0E15\u0E23\u0E39\u0E41\u0E25\u0E30\u0E01\u0E31\u0E1A\u0E14\u0E31\u0E01\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E40\u0E2A\u0E35\u0E22\u0E40\u0E25\u0E37\u0E2D\u0E14
          \u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E28\u0E39\u0E19\u0E22\u0E4C\u0E08\u0E30\u0E08\u0E1A\u0E23\u0E2D\u0E1A\n\u0E02\u0E27\u0E14\u0E22\u0E32\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E1F\u0E37\u0E49\u0E19\u0E1F\u0E39\u0E44\u0E14\u0E49\u0E44\u0E21\u0E48\u0E40\u0E01\u0E34\u0E19\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14"
        english: 'Enemies and traps deal damage. Zero HP ends the run.

          Health
          potions restore HP up to your maximum.'
      accent: {r: 1, g: 0.5803922, b: 0.61960787, a: 1}
    - heading:
        thai: "\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19  \xB7  \u0E41\u0E16\u0E1A\u0E2A\u0E35\u0E1F\u0E49\u0E32"
        english: "Energy  \xB7  Blue bar"
      body:
        thai: "\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E41\u0E25\u0E30\u0E2A\u0E01\u0E34\u0E25\u0E1A\u0E32\u0E07\u0E0A\u0E19\u0E34\u0E14\u0E43\u0E0A\u0E49\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19
          \u0E16\u0E49\u0E32\u0E44\u0E21\u0E48\u0E1E\u0E2D\u0E08\u0E30\u0E43\u0E0A\u0E49\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\n\u0E40\u0E25\u0E02\u0E1A\u0E19\u0E0A\u0E48\u0E2D\u0E07\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E1A\u0E2D\u0E01\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E17\u0E35\u0E48\u0E43\u0E0A\u0E49\u0E15\u0E48\u0E2D\u0E01\u0E32\u0E23\u0E42\u0E08\u0E21\u0E15\u0E35"
        english: 'Some weapons and skills require energy and cannot fire without
          enough.

          The number on the weapon slot shows its energy cost.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "\u0E40\u0E01\u0E47\u0E1A\u0E02\u0E27\u0E14\u0E22\u0E32\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E08\u0E33\u0E40\u0E1B\u0E47\u0E19"
        english: Pick up potions when needed
      body:
        thai: "\u0E40\u0E14\u0E34\u0E19\u0E40\u0E02\u0E49\u0E32\u0E43\u0E01\u0E25\u0E49\u0E40\u0E2B\u0E23\u0E35\u0E22\u0E0D\u0E41\u0E25\u0E30\u0E02\u0E27\u0E14\u0E22\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E01\u0E47\u0E1A\n\u0E16\u0E49\u0E32\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2B\u0E23\u0E37\u0E2D\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E40\u0E15\u0E47\u0E21
          \u0E02\u0E27\u0E14\u0E0A\u0E19\u0E34\u0E14\u0E19\u0E31\u0E49\u0E19\u0E08\u0E30\u0E2D\u0E22\u0E39\u0E48\u0E1A\u0E19\u0E1E\u0E37\u0E49\u0E19\u0E43\u0E2B\u0E49\u0E40\u0E01\u0E47\u0E1A\u0E20\u0E32\u0E22\u0E2B\u0E25\u0E31\u0E07"
        english: 'Walk near coins and potions to collect them.

          A potion
          stays on the ground when its matching resource is full.'
      accent: {r: 0.5882353, g: 0.8862745, b: 0.7019608, a: 1}
  - tab:
      thai: "\u0E23\u0E49\u0E32\u0E19\u0E04\u0E49\u0E32\u0E41\u0E25\u0E30\u0E1A\u0E31\u0E1E"
      english: Shops & buffs
    title:
      thai: "\u0E0B\u0E37\u0E49\u0E2D\u0E02\u0E2D\u0E07\u0E43\u0E2B\u0E49\u0E40\u0E02\u0E49\u0E32\u0E01\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E40\u0E25\u0E48\u0E19"
      english: Shop for your build
    summary:
      thai: "\u0E40\u0E14\u0E34\u0E19\u0E40\u0E02\u0E49\u0E32\u0E43\u0E01\u0E25\u0E49\u0E23\u0E49\u0E32\u0E19\u0E41\u0E25\u0E49\u0E27\u0E01\u0E14
        F \u0E2B\u0E23\u0E37\u0E2D\u0E04\u0E25\u0E34\u0E01\u0E17\u0E35\u0E48\u0E23\u0E49\u0E32\u0E19"
      english: Move near a shop and press F, or click the shop
    sections:
    - heading:
        thai: "\u0E23\u0E49\u0E32\u0E19\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E41\u0E25\u0E30\u0E02\u0E27\u0E14\u0E22\u0E32"
        english: Weapons and potions
      body:
        thai: "\u0E23\u0E49\u0E32\u0E19\u0E21\u0E35\u0E02\u0E27\u0E14\u0E22\u0E32\u0E40\u0E25\u0E37\u0E2D\u0E14
          \u0E02\u0E27\u0E14\u0E22\u0E32\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19
          \u0E41\u0E25\u0E30\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E2A\u0E38\u0E48\u0E21\n\u0E14\u0E39\u0E40\u0E07\u0E34\u0E19\u0E41\u0E25\u0E30\u0E23\u0E32\u0E04\u0E32
          \u0E41\u0E25\u0E49\u0E27\u0E04\u0E25\u0E34\u0E01\u0E1B\u0E38\u0E48\u0E21\u0E23\u0E32\u0E04\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E0B\u0E37\u0E49\u0E2D\u0E2A\u0E34\u0E19\u0E04\u0E49\u0E32\u0E0A\u0E34\u0E49\u0E19\u0E19\u0E31\u0E49\u0E19"
        english: 'Shops stock health potions, energy potions and random weapons.

          Check
          your coins and click an item''s price to buy it.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "\u0E23\u0E49\u0E32\u0E19\u0E2A\u0E35\u0E41\u0E14\u0E07  \xB7  \u0E1A\u0E31\u0E1E\u0E1B\u0E23\u0E30\u0E08\u0E33\u0E23\u0E2D\u0E1A"
        english: "Red shop  \xB7  Run buffs"
      body:
        thai: "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E23\u0E31\u0E1A\u0E1A\u0E31\u0E1E\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14
          \u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14
          \u0E2B\u0E23\u0E37\u0E2D\u0E14\u0E32\u0E40\u0E21\u0E08\n\u0E21\u0E35\u0E1C\u0E25\u0E08\u0E19\u0E08\u0E1A\u0E23\u0E2D\u0E1A\u0E01\u0E32\u0E23\u0E40\u0E25\u0E48\u0E19
          \u0E41\u0E25\u0E30\u0E23\u0E35\u0E40\u0E0B\u0E47\u0E15\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E01\u0E21\u0E43\u0E2B\u0E21\u0E48"
        english: 'Buy bonuses to maximum HP, maximum energy or damage.

          These
          bonuses last for the current run and reset on a new game.'
      accent: {r: 1, g: 0.5803922, b: 0.61960787, a: 1}
    - heading:
        thai: "\u0E2D\u0E48\u0E32\u0E19\u0E02\u0E49\u0E2D\u0E40\u0E2A\u0E35\u0E22\u0E01\u0E48\u0E2D\u0E19\u0E0B\u0E37\u0E49\u0E2D"
        english: Read the trade-off before buying
      body:
        thai: "\u0E23\u0E49\u0E32\u0E19\u0E1A\u0E31\u0E1E\u0E21\u0E35\u0E2A\u0E35\u0E48\u0E02\u0E49\u0E2D\u0E40\u0E2A\u0E19\u0E2D
          \u0E2B\u0E19\u0E36\u0E48\u0E07\u0E02\u0E49\u0E2D\u0E43\u0E2B\u0E49\u0E1C\u0E25\u0E41\u0E23\u0E07\u0E41\u0E15\u0E48\u0E21\u0E35\u0E02\u0E49\u0E2D\u0E40\u0E2A\u0E35\u0E22\n\u0E40\u0E0A\u0E48\u0E19
          \u0E40\u0E1E\u0E34\u0E48\u0E21\u0E14\u0E32\u0E40\u0E21\u0E08\u0E21\u0E32\u0E01\u0E41\u0E15\u0E48\u0E25\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14
          \u0E02\u0E49\u0E2D\u0E40\u0E2A\u0E35\u0E22\u0E21\u0E35\u0E1C\u0E25\u0E17\u0E31\u0E19\u0E17\u0E35"
        english: 'The buff shop has four offers, including one strong bonus with
          a drawback.

          For example, extra damage may reduce maximum HP
          immediately.'
      accent: {r: 1, g: 0.81960785, b: 0.43529412, a: 1}
  - tab:
      thai: "\u0E1E\u0E23\u0E04\u0E27\u0E2D\u0E19\u0E15\u0E31\u0E21"
      english: Blessings
    title:
      thai: "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E1E\u0E23\u0E43\u0E2B\u0E49\u0E40\u0E2A\u0E23\u0E34\u0E21\u0E01\u0E31\u0E19"
      english: Combine your blessings
    summary:
      thai: "\u0E1E\u0E23\u0E08\u0E32\u0E01\u0E01\u0E32\u0E23\u0E1C\u0E48\u0E32\u0E19\u0E14\u0E48\u0E32\u0E19\u0E41\u0E22\u0E01\u0E08\u0E32\u0E01\u0E1A\u0E31\u0E1E\u0E17\u0E35\u0E48\u0E0B\u0E37\u0E49\u0E2D\u0E43\u0E19\u0E23\u0E49\u0E32\u0E19"
      english: Stage-clear blessings are separate from shop buffs
    sections:
    - heading:
        thai: "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E08\u0E32\u0E01\u0E2A\u0E32\u0E21"
        english: Choose one of three
      body:
        thai: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E16\u0E36\u0E07\u0E08\u0E38\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E1E\u0E23
          \u0E40\u0E01\u0E21\u0E08\u0E30\u0E2B\u0E22\u0E38\u0E14\u0E43\u0E2B\u0E49\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E08\u0E32\u0E01\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E48\u0E21\u0E21\u0E32\n\u0E2D\u0E48\u0E32\u0E19\u0E1C\u0E25\u0E02\u0E2D\u0E07\u0E41\u0E15\u0E48\u0E25\u0E30\u0E43\u0E1A
          \u0E41\u0E25\u0E49\u0E27\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E43\u0E2B\u0E49\u0E40\u0E2B\u0E21\u0E32\u0E30\u0E01\u0E31\u0E1A\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E17\u0E35\u0E48\u0E43\u0E0A\u0E49"
        english: 'At blessing selection, the game pauses and offers random cards.

          Read
          each effect and choose one that fits your weapon.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "\u0E2A\u0E30\u0E2A\u0E21\u0E44\u0E14\u0E49\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14\u0E2A\u0E35\u0E48\u0E1E\u0E23"
        english: Keep up to four blessings
      body:
        thai: "\u0E1E\u0E23\u0E17\u0E35\u0E48\u0E21\u0E35\u0E41\u0E25\u0E49\u0E27\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E2D\u0E31\u0E1B\u0E40\u0E01\u0E23\u0E14\u0E44\u0E14\u0E49\u0E16\u0E36\u0E07\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E2A\u0E32\u0E21\n\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E0A\u0E48\u0E2D\u0E07\u0E40\u0E15\u0E47\u0E21\u0E08\u0E30\u0E40\u0E19\u0E49\u0E19\u0E2D\u0E31\u0E1B\u0E40\u0E01\u0E23\u0E14\u0E1E\u0E23\u0E40\u0E14\u0E34\u0E21
          \u0E41\u0E17\u0E19\u0E01\u0E32\u0E23\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E0A\u0E19\u0E34\u0E14\u0E43\u0E2B\u0E21\u0E48"
        english: 'Collect up to four distinct blessings and upgrade them to level
          three.

          When slots are full, offers upgrade existing blessings
          instead.'
      accent: {r: 1, g: 0.81960785, b: 0.43529412, a: 1}
    - heading:
        thai: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E23\u0E2D\u0E1A\u0E43\u0E2B\u0E21\u0E48
          \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E41\u0E19\u0E27\u0E17\u0E32\u0E07\u0E43\u0E2B\u0E21\u0E48"
        english: A new run, a new build
      body:
        thai: "\u0E1E\u0E23\u0E21\u0E35\u0E1C\u0E25\u0E15\u0E32\u0E21\u0E40\u0E07\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E02\u0E02\u0E2D\u0E07\u0E41\u0E15\u0E48\u0E25\u0E30\u0E43\u0E1A
          \u0E40\u0E0A\u0E48\u0E19 \u0E1F\u0E31\u0E19\u0E25\u0E1A\u0E01\u0E23\u0E30\u0E2A\u0E38\u0E19\n\u0E14\u0E39\u0E1E\u0E23\u0E17\u0E35\u0E48\u0E44\u0E14\u0E49\u0E08\u0E32\u0E01\u0E44\u0E2D\u0E04\u0E2D\u0E19\u0E1A\u0E19
          HUD \u0E1E\u0E23\u0E08\u0E30\u0E23\u0E35\u0E40\u0E0B\u0E47\u0E15\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E01\u0E21\u0E43\u0E2B\u0E21\u0E48"
        english: 'Effects have their own conditions, such as clearing bullets with
          a slash.

          Your HUD shows owned blessings. All reset on a new
          run.'
      accent: {r: 0.5882353, g: 0.8862745, b: 0.7019608, a: 1}
  - tab:
      thai: "\u0E2B\u0E49\u0E2D\u0E07\u0E41\u0E25\u0E30\u0E21\u0E34\u0E19\u0E34\u0E41\u0E21\u0E1E"
      english: Rooms & minimap
    title:
      thai: "\u0E2A\u0E33\u0E23\u0E27\u0E08\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E02\u0E2D\u0E07\u0E14\u0E48\u0E32\u0E19"
      english: Find your way through a stage
    summary:
      thai: "\u0E21\u0E34\u0E19\u0E34\u0E41\u0E21\u0E1E\u0E2D\u0E22\u0E39\u0E48\u0E21\u0E38\u0E21\u0E02\u0E27\u0E32\u0E1A\u0E19\u0E43\u0E15\u0E49\u0E08\u0E33\u0E19\u0E27\u0E19\u0E40\u0E07\u0E34\u0E19"
      english: The minimap sits below your coins at the top right
    sections:
    - heading:
        thai: "?  \u0E2B\u0E49\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E2A\u0E33\u0E23\u0E27\u0E08"
        english: '?  Unvisited room'
      body:
        thai: "\u0E40\u0E2A\u0E49\u0E19\u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E21\u0E43\u0E19\u0E21\u0E34\u0E19\u0E34\u0E41\u0E21\u0E1E\u0E41\u0E2A\u0E14\u0E07\u0E17\u0E32\u0E07\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E2B\u0E49\u0E2D\u0E07\n\u0E2B\u0E49\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E40\u0E04\u0E22\u0E40\u0E02\u0E49\u0E32\u0E41\u0E25\u0E49\u0E27\u0E08\u0E30\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E2A\u0E16\u0E32\u0E19\u0E30\u0E43\u0E2B\u0E49\u0E41\u0E22\u0E01\u0E08\u0E32\u0E01\u0E2B\u0E49\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E40\u0E02\u0E49\u0E32"
        english: 'Connections show paths between rooms.

          Visited rooms
          look different from rooms you have not entered.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E1B\u0E34\u0E14\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49"
        english: Combat locks the doors
      body:
        thai: "\u0E2B\u0E49\u0E2D\u0E07\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E08\u0E30\u0E01\u0E31\u0E49\u0E19\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E08\u0E19\u0E01\u0E27\u0E48\u0E32\u0E08\u0E30\u0E01\u0E33\u0E08\u0E31\u0E14\u0E28\u0E31\u0E15\u0E23\u0E39\u0E04\u0E23\u0E1A\u0E15\u0E32\u0E21\u0E40\u0E07\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E02\n\u0E2A\u0E31\u0E07\u0E40\u0E01\u0E15\u0E27\u0E31\u0E15\u0E16\u0E38\u0E17\u0E33\u0E25\u0E32\u0E22\u0E44\u0E14\u0E49
          \u0E0B\u0E36\u0E48\u0E07\u0E2D\u0E32\u0E08\u0E43\u0E2B\u0E49\u0E02\u0E27\u0E14\u0E22\u0E32\u0E1F\u0E37\u0E49\u0E19\u0E1F\u0E39"
        english: 'Combat rooms keep doors shut until their enemies are cleared.

          Breakable
          objects may drop healing or energy potions.'
      accent: {r: 1, g: 0.81960785, b: 0.43529412, a: 1}
    - heading:
        thai: "\u0E44\u0E2D\u0E04\u0E2D\u0E19\u0E27\u0E32\u0E23\u0E4C\u0E1B  \xB7 
          \u0E17\u0E32\u0E07\u0E44\u0E1B\u0E14\u0E48\u0E32\u0E19\u0E16\u0E31\u0E14\u0E44\u0E1B"
        english: "Portal icon  \xB7  Next stage"
      body:
        thai: "\u0E2B\u0E25\u0E31\u0E07\u0E1E\u0E1A\u0E2B\u0E49\u0E2D\u0E07\u0E27\u0E32\u0E23\u0E4C\u0E1B
          \u0E21\u0E34\u0E19\u0E34\u0E41\u0E21\u0E1E\u0E08\u0E30\u0E41\u0E2A\u0E14\u0E07\u0E44\u0E2D\u0E04\u0E2D\u0E19\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E21\u0E34\u0E15\u0E34\n\u0E40\u0E04\u0E25\u0E35\u0E22\u0E23\u0E4C\u0E2B\u0E49\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E40\u0E1D\u0E49\u0E32\u0E27\u0E32\u0E23\u0E4C\u0E1B
          \u0E41\u0E25\u0E49\u0E27\u0E40\u0E02\u0E49\u0E32\u0E43\u0E01\u0E25\u0E49\u0E01\u0E14
          F \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E14\u0E34\u0E19\u0E17\u0E32\u0E07\u0E15\u0E48\u0E2D"
        english: 'After discovering the exit room, its portal icon appears on the
          minimap.

          Clear its guards, approach the portal and press F to
          continue.'
      accent: {r: 0.5882353, g: 0.8862745, b: 0.7019608, a: 1}
  - tab:
      thai: "\u0E01\u0E31\u0E1A\u0E14\u0E31\u0E01\u0E41\u0E25\u0E30\u0E1A\u0E2D\u0E2A"
      english: Traps & bosses
    title:
      thai: "\u0E14\u0E39\u0E2A\u0E31\u0E0D\u0E0D\u0E32\u0E13\u0E01\u0E48\u0E2D\u0E19\u0E2D\u0E31\u0E19\u0E15\u0E23\u0E32\u0E22"
      english: Read the warning signs
    summary:
      thai: "\u0E01\u0E32\u0E23\u0E2B\u0E25\u0E1A\u0E41\u0E25\u0E30\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E1E\u0E2D
        \u0E46 \u0E01\u0E31\u0E1A\u0E14\u0E32\u0E40\u0E21\u0E08"
      english: Positioning and timing matter as much as damage
    sections:
    - heading:
        thai: "\u0E0B\u0E32\u0E01\u0E22\u0E32\u0E19  \xB7  \u0E23\u0E2D\u0E22\u0E41\u0E22\u0E01\u0E41\u0E25\u0E30\u0E2B\u0E19\u0E32\u0E21"
        english: "Shipwreck  \xB7  Rifts and spikes"
      body:
        thai: "\u0E2B\u0E25\u0E1A\u0E23\u0E2D\u0E22\u0E41\u0E22\u0E01\u0E2A\u0E35\u0E21\u0E48\u0E27\u0E07\u0E17\u0E35\u0E48\u0E14\u0E36\u0E07\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E19
          \u0E41\u0E25\u0E30\u0E23\u0E30\u0E27\u0E31\u0E07\u0E1E\u0E37\u0E49\u0E19\u0E2B\u0E19\u0E32\u0E21\n\u0E2B\u0E19\u0E32\u0E21\u0E17\u0E33\u0E07\u0E32\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E23\u0E2D\u0E1A
          \u0E21\u0E35\u0E2A\u0E31\u0E0D\u0E0D\u0E32\u0E13\u0E40\u0E15\u0E37\u0E2D\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E1E\u0E38\u0E48\u0E07\u0E02\u0E36\u0E49\u0E19"
        english: 'Avoid purple rifts that pull you in, and watch for spike tiles.

          Spikes
          activate in cycles and warn before rising.'
      accent: {r: 0.50980395, g: 0.90588236, b: 0.9490196, a: 1}
    - heading:
        thai: "\u0E1B\u0E48\u0E32\u0E21\u0E34\u0E15\u0E34  \xB7  \u0E40\u0E16\u0E32\u0E27\u0E31\u0E25\u0E22\u0E4C\u0E1E\u0E34\u0E29"
        english: "Dimensional forest  \xB7  Poison vines"
      body:
        thai: "\u0E2D\u0E2D\u0E01\u0E08\u0E32\u0E01\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E40\u0E15\u0E37\u0E2D\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E16\u0E32\u0E27\u0E31\u0E25\u0E22\u0E4C\u0E42\u0E08\u0E21\u0E15\u0E35\n\u0E1E\u0E34\u0E29\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E40\u0E2A\u0E35\u0E22\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E15\u0E48\u0E2D\u0E40\u0E19\u0E37\u0E48\u0E2D\u0E07\u0E0A\u0E31\u0E48\u0E27\u0E04\u0E23\u0E32\u0E27
          \u0E23\u0E30\u0E27\u0E31\u0E07\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E2B\u0E25\u0E1A"
        english: 'Leave warning areas before the vines strike.

          Poison
          drains HP over time for a limited duration.'
      accent: {r: 0.5882353, g: 0.8862745, b: 0.7019608, a: 1}
    - heading:
        thai: "\u0E1A\u0E2D\u0E2A  \xB7  \u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E15\u0E32\u0E21\u0E40\u0E1F\u0E2A"
        english: "Bosses  \xB7  Watch for phase changes"
      body:
        thai: "\u0E2A\u0E31\u0E07\u0E40\u0E01\u0E15\u0E17\u0E48\u0E32\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E42\u0E08\u0E21\u0E15\u0E35\u0E41\u0E25\u0E30\u0E2B\u0E25\u0E2D\u0E14\u0E40\u0E25\u0E37\u0E2D\u0E14\u0E1A\u0E2D\u0E2A\n\u0E1A\u0E2D\u0E2A\u0E1A\u0E32\u0E07\u0E15\u0E31\u0E27\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E17\u0E48\u0E32\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E1B\u0E34\u0E14\u0E1E\u0E37\u0E49\u0E19\u0E2D\u0E31\u0E19\u0E15\u0E23\u0E32\u0E22\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E40\u0E1F\u0E2A"
        english: 'Watch attack wind-ups and the boss health bar.

          Some
          bosses change attacks or activate floor hazards in later phases.'
      accent: {r: 1, g: 0.5803922, b: 0.61960787, a: 1}
